{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(uv run python:*)",
      "Bash(uv run pyrefly:*)",
      "Bash(git log:*)",
      "Bash(git check-ignore:*)",
      "Bash(uv sync:*)",
      "Bash(gh pr *)",
      "Bash(gh issue view *)",
      "Bash(git diff *)",
      "Bash(peer-review *)",
      "Read(//tmp/**)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(timeout 300 pnpm test)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(*.env)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.kdbx)",
      "Read(*.age)",
      "Read(*.sops.*)",
      "Read(secrets.yml)",
      "Read(secrets.yaml)",
      "Read(vault.yml)",
      "Read(vault.yaml)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/session-end-sync-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/agents-md-hook.sh",
            "statusMessage": "Loading AGENTS.md"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/statusline-loc-reset.sh",
            "statusMessage": "Resetting LOC counter"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/stop-queue-hook.sh",
            "statusMessage": "Checking message queue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/agents-md-diff-hook.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "safety-net@safety-net-dev": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "kitty",
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true
}
