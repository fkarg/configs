# GitHub CLI credentials live in the host keyring and are unavailable in the
# workspace sandbox. All gh commands run on the host without prompting.

prefix_rule(
    pattern = ["gh"],
    decision = "allow",
    justification = "GitHub CLI always needs access to host keyring credentials",
    match = [
        "gh auth status -h github.com",
        "gh issue view 682 --json body",
        "gh pr create --title Example",
        "gh api graphql -f query={viewer{login}}",
        "gh run rerun 1234",
        "gh extension exec example",
    ],
)

# Git commands are trusted. This rule intentionally covers all subcommands,
# including metadata mutations, hooks, helpers, and remote operations.
prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Git commands are always allowed",
    match = [
        "git status",
        "git fetch origin main",
        "git add app/example.ts",
        "git commit -m test: example",
        "git push -u origin HEAD",
        "git worktree add -b 682-fix .worktrees/682-fix main",
        "git worktree remove .worktrees/682-fix",
        "git reset --hard",
        "git clean -fd",
    ],
)

prefix_rule(
    pattern = ["claude", "-p"],
    decision = "prompt",
    justification = "Claude print mode needs host credential refresh and runs another agent",
    match = ["claude -p Review this design"],
    not_match = ["claude auth status"],
)
