#!/usr/bin/env sh
# Managed by ansible: ansible/roles/graphical_dotfiles/templates/kvm_switch.sh.j2
# Bound to Ctrl+Shift+F12 in dotconfig/hypr/hyprland.conf.
# Flips the shared monitor to the *other* host's input via DDC/CI, exactly
# once: repeated setvcp calls fight the monitor's input arbitration and cause
# visible flicker. The target input code is per-host: kvm_switch_target_input
# in inventory/host_vars (e.g. jolly = 21/0x15 USB-C → caeli). Requires
# ddcutil + i2c-dev access (hardware.i2c.enable on NixOS hosts).
ddcutil setvcp 60 {{ kvm_switch_target_input | int }}
