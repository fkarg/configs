#!/usr/bin/env sh
# Managed by ansible: ansible/roles/graphical_dotfiles/templates/kvm_switch_macos.sh.j2
# Invoked by the Karabiner KVM rules. If kvm_self_input is configured, toggles
# between self and target on the Philips KVM; otherwise just sets target.
# The input is selected exactly once — repeated re-selects fight the monitor's
# input arbitration and cause visible flicker. Called with the argument "sleep"
# (the Ctrl+Shift+F11 rule) it also puts this host to sleep right after
# switching, so its own input signal drops and the monitor can no longer
# auto-hop back to it while the other host boots.
set -eu

M1DDC=/opt/homebrew/bin/m1ddc
{% if kvm_display_id | default('') | length > 0 %}
DISPLAY_ARG="display {{ kvm_display_id }}"
{% else %}
DISPLAY_ARG=""
{% endif %}
TARGET={{ kvm_switch_target_input | int }}

{% if kvm_self_input not in [None, ''] %}
SELF={{ kvm_self_input | int }}
current=$($M1DDC $DISPLAY_ARG get input 2>/dev/null | tr -d '[:space:]')
if [ "$current" = "$SELF" ]; then
  SELECTED=$TARGET
else
  SELECTED=$SELF
fi
{% else %}
SELECTED=$TARGET
{% endif %}
# Deliberately not gated on m1ddc's exit status: the switch tears down the very
# USB-C DDC link the command rides on, so m1ddc can report failure for a switch
# that physically happened. Under `set -e` that aborted the script before the
# sleep below — silently, since nothing here is on a terminal.
$M1DDC $DISPLAY_ARG set input "$SELECTED" || true

if [ "${1:-}" = "sleep" ]; then
  # Let the hand-over settle first. The monitor releasing its USB hub fires a
  # USB-C plug event on this host (visible in `pmset -g log` as wake reason
  # USB-C_plug), and that cancels a sleep requested in the same moment.
  # Karabiner forcibly terminates a running shell_command when the next one is
  # invoked, so this window is interruptible -- harmless, because by then the
  # keyboard has already followed the monitor to the other host.
  sleep 2
  /usr/bin/pmset sleepnow
fi
