# fish config file.
# {{ ansible_managed }}

{% if ansible_facts['system'] == 'Darwin' %}
# Homebrew PATH (macOS)
# -gP keeps this session-local instead of persisting to the universal
# fish_user_paths, which lives in the repo-shared fish_variables and
# would leak macOS paths onto Linux hosts.
if test -d /opt/homebrew/bin
    fish_add_path -gP /opt/homebrew/bin
else if test -d /usr/local/bin
    fish_add_path -gP /usr/local/bin
end

# Homebrew 6.0 made "ask mode" (a confirm prompt before install/upgrade) the
# default; HOMEBREW_NO_ASK opts back out so brew stays non-interactive.
set -x HOMEBREW_NO_ASK 1
{% endif %}


function fish_greeting
  fortune -as | cowthink -f {{ cowfile }}
  echo
end

if status --is-interactive
  echo ----\((hostname)\)----
  echo "You are only human. Pay attention to your communication. Value each step forward."
  echo "Succeed, with no wasted motion. What is your ONE Thing right now?"
end

# Warn at login when the background system upgrade is failing.
#
# system.autoUpgrade runs with operation = "boot", so a broken build stages
# nothing and the running desktop is completely unaffected. The failure is
# invisible until you happen to notice the kernel never moved — that is how
# jolly sat on a stale generation from 2026-08-05 to 2026-08-24.
#
# nixos/shared/policy/upgrade-notify.nix fires a desktop toast at failure time;
# this is the backstop for failures with no session up to receive it (the timer
# is Persistent=true, so catch-up runs can land before the desktop is ready).
#
# Guarded on systemctl so it stays inert on macOS and non-systemd hosts;
# is-failed is also non-zero on hosts that simply have no nixos-upgrade unit.
if status --is-interactive; and command -q systemctl
  if systemctl is-failed --quiet nixos-upgrade.service
    set -l detail ""
    set -l when (systemctl show nixos-upgrade.service -p ExecMainExitTimestamp --value 2>/dev/null)
    if test -n "$when"
      set -l failed_at (date -d "$when" +%s 2>/dev/null)
      if test -n "$failed_at"
        set -l secs (math (date +%s) - $failed_at)
        if test $secs -ge 86400
          set detail " ("(math -s0 $secs / 86400)"d ago)"
        else
          set detail " ("(math -s0 $secs / 3600)"h ago)"
        end
      end
    end
    set_color --bold red
    echo "⚠ nixos-upgrade is failing$detail — no new generation is being staged."
    set_color normal
    echo "  journalctl -u nixos-upgrade -e"
  end
end



# fish_add_path -P is idempotent, so nested shells don't re-prepend these.
# pnpm resolves its global bin dir to ~/.local/share/pnpm/bin on its own; bun
# needs BUN_INSTALL/bin exported + on PATH for `bun install -g` shims to resolve.
# (fish_add_path skips dirs that don't exist yet, so ~/.bun/bin only joins PATH
# once bun has created it — open a fresh shell after the first `bun install -g`.)
set -gx BUN_INSTALL ~/.bun
fish_add_path -gP ~/.cargo/bin ~/.local/bin ~/.local/share/pnpm/bin $BUN_INSTALL/bin

# set -x LD_LIBRARY_PATH (nix-build -E 'import <nixpkgs>' -A 'gcc.cc.lib')/lib64
# set -x PATH $LD_LIBRARY_PATH $PATH

set -x FZF_DEFAULT_COMMAND 'rg --files --no-ignore --hidden --follow --glob "!.git/*"'

# Force truecolor. kitty sets `term xterm-256color` for remote terminfo
# compatibility, but it doesn't advertise the RGB capability, so terminal
# multiplexers fall back to 256 colors. tmux works around this with
# `terminal-overrides ",xterm*:RGB"`;
# zellij has no terminfo override and keys truecolor purely off $COLORTERM, so
# exporting it here is what makes its (and everything else's) colors correct.
set -x COLORTERM truecolor

# This script was automatically generated by the broot function
# More information can be found in https://github.com/Canop/broot

# This function starts broot and executes the command
# it produces, if any.
# It's needed because some shell commands, like `cd`,
# have no useful effect if executed in a subshell.
function br
    set f (mktemp)
    broot --outcmd $f $argv
    if test $status -ne 0
        rm -f "$f"
        return "$code"
    end
    set d (cat "$f")
    rm -f "$f"
    eval "$d"
end

