#!/usr/bin/env bash
# Resize the focused Hyprland window to a fraction of its monitor's logical
# (post-scaling) size.
#
# Usage:
#   hypr-resize <width_fraction> [<height_fraction>]   # fractional resize
#
# Examples:
#   hypr-resize 0.333          # focused window becomes 1/3 monitor-wide
#   hypr-resize 0.667          # 2/3 wide
#   hypr-resize 0.5 0.5        # half-and-half
#   hypr-resize 1 1            # fullscreen-ish (tile-respecting)
#
# Invoked from .desktop entries so it's discoverable in launchers
# (hyprlauncher, fuzzel, walker, rofi …).
#
# NOTE: an N-way "equalize all tiled windows" mode was removed. dwindle resizes
# act on its opaque binary split-tree, so for 3+ windows the outcome depends on
# the (unknowable-to-a-script) tree shape and reproducibly collapses a column
# instead of equalizing. Revisit equalization under the hy3 layout, where N-way
# splits are first-class — see nixos/shared/desktops/hyprland-session.nix.

set -u

mode=${1:-}
if [ -z "$mode" ]; then
  echo "usage: $0 <width_fraction> [<height_fraction>]" >&2
  exit 1
fi

mon=$(hyprctl monitors -j | jq '.[] | select(.focused)')
mw=$(jq -r '.width'  <<<"$mon")
mh=$(jq -r '.height' <<<"$mon")
scale=$(jq -r '.scale' <<<"$mon")

# Logical pixels = physical / scale; resize dispatchers expect logical.
lw=$(awk -v w="$mw" -v s="$scale" 'BEGIN{ printf "%d", w / s }')
lh=$(awk -v h="$mh" -v s="$scale" 'BEGIN{ printf "%d", h / s }')

# Fractional resize of the active window.
frac_w=$mode
frac_h=${2:-}

win=$(hyprctl activewindow -j)
cw=$(jq -r '.size[0]' <<<"$win")
ch=$(jq -r '.size[1]' <<<"$win")

tw=$(awk -v w="$lw" -v f="$frac_w" 'BEGIN{ printf "%d", w * f }')
if [ -n "$frac_h" ]; then
  th=$(awk -v h="$lh" -v f="$frac_h" 'BEGIN{ printf "%d", h * f }')
else
  th=$ch
fi

# Lone-tile case: dwindle snaps the tile straight back to fill the workspace,
# so the resize is a deliberate no-op. (An earlier version floated the window
# first to make it visible, gated on the active workspace's tiled count — but
# with a special workspace open, `hyprctl activeworkspace` reports the regular
# workspace *underneath*, so scratchpad windows with tiled siblings got floated
# too, and floats accumulated: a float no longer counts as tiled, so each next
# window became the "lone tile" and got floated on resize. Float manually with
# SUPER+V if you want a lone window at fractional width.)

# Under a Lua config hyprctl takes Lua, not the old `dispatcher arg arg` form.
if [ "$(jq -r '.floating' <<<"$win")" = "true" ]; then
  # Floating windows take absolute x/y correctly (applying twice is a no-op).
  hyprctl dispatch "hl.dsp.window.resize({ x = $tw, y = $th })" >/dev/null
  exit 0
fi

# Tiled windows: window.resize treats its delta (absolute mode: target -
# current) as a displacement of the *grabbed edge*, and a window touching the
# monitor's right (bottom) edge grabs its left (top) edge — so the absolute
# form inverts there: a shrink request grows the window and vice versa
# (verified empirically on 0.55). Compute the delta ourselves and flip the
# sign for edge-anchored windows; 40px tolerance covers gaps and borders.
wx=$(jq -r '.at[0]' <<<"$win")
wy=$(jq -r '.at[1]' <<<"$win")
mon_x=$(jq -r '.x' <<<"$mon")
mon_y=$(jq -r '.y' <<<"$mon")

dx=$((tw - cw))
dy=$((th - ch))
if [ $((mon_x + lw - wx - cw)) -lt 40 ]; then dx=$((-dx)); fi
if [ $((mon_y + lh - wy - ch)) -lt 40 ]; then dy=$((-dy)); fi

hyprctl dispatch "hl.dsp.window.resize({ x = $dx, y = $dy, relative = true })" >/dev/null
